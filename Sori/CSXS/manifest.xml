<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.sori.panel" ExtensionBundleVersion="1.3.0" ExtensionBundleName="Sori" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.sori.panel" Version="1.3.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.sori.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/Sori_Premiere.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node.js (window.cep_node) : apparence partagée avec Mori / Ongaku, export des presets -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Sori — Courbes</Menu>
          <Geometry>
            <Size>
              <Height>760</Height>
              <Width>520</Width>
            </Size>
            <MinSize>
              <Height>450</Height>
              <Width>360</Width>
            </MinSize>
            <MaxSize>
              <Height>2000</Height>
              <Width>1600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
